<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;700&display=swap" rel="stylesheet">
{% include "_styles.html.j2" %}
<style>
.aviso{
  background:var(--ink-black);color:#fff;border-radius:var(--radius);
  padding:30px 32px;margin:8px 0 12px
}
.aviso h2{font-weight:700;font-size:21px;margin:0 0 12px;letter-spacing:-.01em}
.aviso p{font-weight:300;margin:0 0 12px;color:#C7C9D0;font-size:15px;max-width:66ch}
.aviso p:last-child{margin-bottom:0}
.aviso strong{color:#fff;font-weight:500}
.accion{
  margin-top:14px;padding:13px 16px;background:var(--soft-gray);
  border-radius:10px;font-size:14px
}
.accion b{font-weight:500}
.dato{border-left:3px solid var(--deep-cobalt);padding-left:16px;margin:12px 0;font-weight:300;color:var(--ink-60)}
</style>
</head>
<body>
<div class="wrap">

  <header class="hero">
    <div class="wordmark">2894</div>
    {% if publico %}
    <h1>Diseño de producto en España.</h1>
    <p class="plain">Empresas con producto digital propio que merece la pena seguir, con
       enlace directo a sus vacantes de diseño en LinkedIn.</p>
    {% else %}
    <h1>Por dónde empezar.</h1>
    <p class="plain">Una primera lista de empresas a las que llamar, para no esperar a la
       primera ejecución del radar.</p>
    {% endif %}
    <div class="meta">
      <span>Generado <code>{{ contexto.generado }}</code></span>
      <span>Método <code>{{ contexto.metodo }}</code></span>
    </div>
  </header>

  <div class="aviso">
    <h2>Qué fiabilidad tiene esta lista</h2>
    <p>Esta lista <strong>no sale de LinkedIn</strong>. Se construyó con búsqueda web y
       conocimiento del mercado español, porque el entorno donde se desarrolló la
       herramienta no tenía salida a internet y no pudo consultar LinkedIn.</p>
    <p>Por eso cada empresa lleva su nivel de evidencia, y <strong>no se ha inventado
       ninguna oferta ni ninguna URL</strong>. Donde la fuente anonimiza el nombre de la
       empresa, se dice así en vez de adivinarlo.</p>
    {% if not publico %}
    <p>La lista completa y fiable sale de ejecutar el radar:
       <code>rrhh-tools search --source session</code>.</p>
    {% endif %}
  </div>

  <section>
    <div class="sec-head">
      <div class="tag">Contexto</div>
      <h2>Cómo está el mercado.</h2>
      <p>Datos públicos que enmarcan {{ 'el mercado' if publico else 'la conversación comercial' }}.</p>
    </div>
    {% for d in contexto.datos_de_mercado %}
    <p class="dato">{{ d }}</p>
    {% endfor %}
  </section>

  {% include "_filtros.html.j2" %}

  {% for grupo in grupos %}
  <section data-seccion="{{ loop.index }}">
    <div class="sec-head">
      <div class="tag">{{ grupo.tag }}</div>
      <h2>{{ grupo.titulo }}.</h2>
      <p>{{ grupo.descripcion }}</p>
    </div>
    <div data-lista>
    {% for e in grupo.empresas %}
    <article class="card" data-ficha
             data-evidencia="{{ e.evidencia }}"
             data-ubicacion="{{ e.clave_ubicacion }}">
      <div class="card-top">
        <div class="marca">
          {% if e.logo %}
          <img class="logo" src="{{ e.logo }}" alt="" loading="lazy"
               onerror="this.outerHTML='<div class=\'monograma\'>{{ e.monograma }}</div>'">
          {% else %}
          <div class="monograma">{{ e.monograma }}</div>
          {% endif %}
          <div>
          <h3>{{ e.nombre }}</h3>
          <div class="badges">
            <span class="badge {{ 'brand' if e.evidencia == 'confirmada' else 'line' }}">
              {{ 'Vacante confirmada' if e.evidencia == 'confirmada' else 'A verificar' }}
            </span>
            {% if e.sector %}<span class="badge line">{{ e.sector }}</span>{% endif %}
            {% if e.ubicacion %}<span class="badge line">{{ e.ubicacion }}</span>{% endif %}
            {% if e.vacante %}<span class="badge line">{{ e.vacante }}</span>{% endif %}
          </div>
          </div>
        </div>
      </div>
      {% if e.detalle %}<p class="why">{{ e.detalle }}</p>{% endif %}
      {% if e.por_que %}
      <p class="why"><b style="font-weight:500;color:var(--ink-black)">Por qué:</b> {{ e.por_que }}</p>
      {% endif %}
      {% if e.accion %}<div class="accion"><b>Siguiente paso:</b> {{ e.accion }}</div>{% endif %}
      {% if e.enlaces %}
      <div class="enlaces">
        {% for l in e.enlaces %}
        <a class="enlace" href="{{ l.url }}" target="_blank" rel="noopener">{{ l.texto }}</a>
        {% endfor %}
      </div>
      {% endif %}
    </article>
    {% endfor %}
    </div>
  </section>
  {% endfor %}

  <section>
    <div class="sec-head">
      {% if publico %}
      <div class="tag">Agencias y consultoras</div>
      <h2>Quién más contrata diseño.</h2>
      <p>Agencias y consultoras con vacantes de diseño. Se listan como parte de la foto
         del mercado.</p>
      {% else %}
      <div class="tag">Bloque B</div>
      <h2>Señal de competencia.</h2>
      <p>Empresas con vacante de diseño que <em>no</em> son objetivo comercial.
         Se listan porque dicen algo del mercado, no porque haya que llamarlas.</p>
      {% endif %}
    </div>
    {% for c in competencia %}
    <article class="card dark">
      <div class="card-top">
        <div class="marca">
          {% if c.logo %}
          <img class="logo" src="{{ c.logo }}" alt="" loading="lazy"
               onerror="this.outerHTML='<div class=\'monograma\'>{{ c.monograma }}</div>'">
          {% else %}
          <div class="monograma">{{ c.monograma }}</div>
          {% endif %}
          <div>
          <h3>{{ c.nombre }}</h3>
          <div class="badges"><span class="badge line">{{ c.tipo }}</span></div>
          </div>
        </div>
      </div>
      <p class="why">{{ c.detalle }}</p>
      {% if c.lectura %}
      <p class="why"><b style="font-weight:500;color:#fff">Lectura:</b> {{ c.lectura }}</p>
      {% endif %}
      {% if c.enlaces %}
      <div class="enlaces">
        {% for l in c.enlaces %}
        <a class="enlace" href="{{ l.url }}" target="_blank" rel="noopener">{{ l.texto }}</a>
        {% endfor %}
      </div>
      {% endif %}
    </article>
    {% endfor %}
  </section>

  <footer>
    {% if publico %}
    <p class="poetic">El mercado, en una página.</p>
    <p class="plain">Quién tiene producto digital propio en España y dónde comprobarlo.</p>
    <p class="note">
      {{ n_confirmadas }} empresas con evidencia de vacante y {{ n_estrategicas }} sin
      confirmar. Las segundas no son vacantes comprobadas: comprobadlas en LinkedIn antes
      de darlas por buenas.
    </p>
    {% else %}
    <p class="poetic">Ellos buscan. Nosotros presentamos.</p>
    <p class="plain">Esta lista prepara la conversación; la llamada la hacéis vosotros.</p>
    <p class="note">
      {{ n_confirmadas }} empresas con evidencia de vacante y {{ n_estrategicas }} objetivos
      estratégicos por verificar. Los objetivos estratégicos son hipótesis razonadas sobre
      el perfil de la empresa, no vacantes comprobadas: confirmadlas antes de invertir
      tiempo comercial en ellas.
    </p>
    {% endif %}
  </footer>

</div>
</body>
</html>
