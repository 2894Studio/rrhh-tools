{# Filtros de cliente, compartidos por los dos informes.

   Mejora progresiva: los controles NO están en el HTML servido, los construye
   el script. Así, si el JavaScript no puede ejecutarse, no aparecen botones
   muertos: se ve todo el contenido en el orden que decidió el servidor.

   Las facetas se declaran en un <script type="application/json"> en vez de
   generarse desde el DOM, para que cada informe controle qué se puede filtrar
   y con qué etiquetas, sin que el script tenga que adivinar. #}
<div id="filtros" class="filtros"></div>
<p id="recuento" class="recuento" aria-live="polite"></p>
<div id="vacio" class="vacio" hidden>
  <p>Ningún resultado con estos filtros.</p>
  <button type="button" class="enlace" data-limpiar>Quitar los filtros</button>
</div>

{# |safe porque el JSON lo genera el renderer a partir de constantes propias,
   nunca de datos de LinkedIn. El renderer ademas neutraliza "<", para que
   ningun contenido pueda cerrar este <script> aunque algun dia entren datos
   externos por aqui. #}
<script type="application/json" id="facetas">{{ facetas_json|safe }}</script>
<script>
// Los controles se pintan arriba, pero las fichas estan mas abajo en el
// documento: hay que esperar a que el DOM este completo o no se encuentra
// ninguna y el script se rinde en silencio.
document.addEventListener("DOMContentLoaded", function () {
  "use strict";
  var raiz = document.getElementById("filtros");
  var facetas = JSON.parse(document.getElementById("facetas").textContent);
  var fichas = Array.prototype.slice.call(document.querySelectorAll("[data-ficha]"));
  if (!raiz || !fichas.length) return;

  var estado = {};
  facetas.forEach(function (f) { estado[f.clave] = f.multi ? [] : ""; });
  var orden = "reciente";

  // --- construcción de los controles ---
  facetas.forEach(function (faceta) {
    var grupo = document.createElement("div");
    grupo.className = "grupo-filtro";
    grupo.setAttribute("role", "group");
    grupo.setAttribute("aria-label", faceta.etiqueta);

    var titulo = document.createElement("span");
    titulo.className = "grupo-titulo";
    titulo.textContent = faceta.etiqueta;
    grupo.appendChild(titulo);

    faceta.opciones.forEach(function (op) {
      var boton = document.createElement("button");
      boton.type = "button";
      boton.className = "chip";
      boton.textContent = op.etiqueta;
      boton.setAttribute("aria-pressed", "false");
      boton.addEventListener("click", function () {
        if (faceta.multi) {
          var i = estado[faceta.clave].indexOf(op.valor);
          if (i === -1) { estado[faceta.clave].push(op.valor); }
          else { estado[faceta.clave].splice(i, 1); }
        } else {
          estado[faceta.clave] = estado[faceta.clave] === op.valor ? "" : op.valor;
        }
        pintar();
      });
      boton.dataset.faceta = faceta.clave;
      boton.dataset.valor = op.valor;
      grupo.appendChild(boton);
    });

    if (faceta.atajo) {
      var atajo = document.createElement("button");
      atajo.type = "button";
      atajo.className = "atajo";
      atajo.textContent = faceta.atajo.etiqueta;
      atajo.addEventListener("click", function () {
        estado[faceta.clave] = faceta.multi
          ? faceta.atajo.valores.slice() : faceta.atajo.valores[0];
        pintar();
      });
      grupo.appendChild(atajo);
    }
    raiz.appendChild(grupo);
  });

  if (facetas.some(function (f) { return f.clave === "dias"; })) {
    var grupoOrden = document.createElement("div");
    grupoOrden.className = "grupo-filtro";
    var etiqueta = document.createElement("label");
    etiqueta.className = "grupo-titulo";
    etiqueta.setAttribute("for", "selector-orden");
    etiqueta.textContent = "Orden";
    var select = document.createElement("select");
    select.id = "selector-orden";
    select.className = "selector";
    [["reciente", "Más recientes"], ["prioridad", "Prioridad"]].forEach(function (o) {
      var opcion = document.createElement("option");
      opcion.value = o[0]; opcion.textContent = o[1];
      select.appendChild(opcion);
    });
    select.addEventListener("change", function () { orden = select.value; pintar(); });
    grupoOrden.appendChild(etiqueta);
    grupoOrden.appendChild(select);
    raiz.appendChild(grupoOrden);
  }

  var limpiar = document.createElement("button");
  limpiar.type = "button";
  limpiar.className = "atajo";
  limpiar.textContent = "Quitar filtros";
  limpiar.addEventListener("click", reiniciar);
  raiz.appendChild(limpiar);
  document.querySelectorAll("[data-limpiar]").forEach(function (b) {
    b.addEventListener("click", reiniciar);
  });

  function reiniciar() {
    facetas.forEach(function (f) { estado[f.clave] = f.multi ? [] : ""; });
    pintar();
  }

  // --- filtrado ---
  function casa(ficha) {
    return facetas.every(function (faceta) {
      var elegido = estado[faceta.clave];
      if (!elegido || (faceta.multi && !elegido.length)) return true;
      var bruto = ficha.dataset[faceta.clave] || "";
      if (faceta.tipo === "max") {
        var dias = parseInt(bruto, 10);
        return !isNaN(dias) && dias <= parseInt(elegido, 10);
      }
      // Una ficha puede llevar varios valores: aparece si CUALQUIERA casa,
      // porque una empresa puede tener vacantes de varios niveles y roles.
      var valores = bruto.split(" ").filter(Boolean);
      var buscados = faceta.multi ? elegido : [elegido];
      return buscados.some(function (v) { return valores.indexOf(v) !== -1; });
    });
  }

  function pintar() {
    raiz.querySelectorAll(".chip").forEach(function (b) {
      var elegido = estado[b.dataset.faceta];
      var activo = Array.isArray(elegido)
        ? elegido.indexOf(b.dataset.valor) !== -1
        : elegido === b.dataset.valor;
      b.setAttribute("aria-pressed", activo ? "true" : "false");
      b.classList.toggle("activo", activo);
    });

    var visibles = 0;
    fichas.forEach(function (ficha) {
      var ok = casa(ficha);
      ficha.hidden = !ok;
      if (ok) visibles++;
      // Las vacantes que no casan se atenúan en vez de desaparecer: si no,
      // parecería que la empresa solo tiene una.
      ficha.querySelectorAll("[data-vacante]").forEach(function (v) {
        var casaVacante = facetas.every(function (faceta) {
          if (faceta.clave !== "nivel" && faceta.clave !== "rol") return true;
          var elegido = estado[faceta.clave];
          if (!elegido.length) return true;
          return elegido.indexOf(v.dataset[faceta.clave]) !== -1;
        });
        v.classList.toggle("atenuada", !casaVacante);
      });
    });

    ordenar();

    document.querySelectorAll("[data-seccion]").forEach(function (sec) {
      var algo = sec.querySelector("[data-ficha]:not([hidden])");
      sec.hidden = !algo;
    });

    var total = fichas.length;
    document.getElementById("recuento").textContent =
      visibles === total
        ? "Mostrando las " + total + " empresas."
        : "Mostrando " + visibles + " de " + total + " empresas.";
    document.getElementById("vacio").hidden = visibles !== 0;
  }

  function ordenar() {
    document.querySelectorAll("[data-lista]").forEach(function (lista) {
      var hijos = Array.prototype.slice.call(lista.querySelectorAll("[data-ficha]"));
      hijos.sort(function (a, b) {
        if (orden === "prioridad") {
          return parseFloat(b.dataset.score) - parseFloat(a.dataset.score);
        }
        var da = parseInt(a.dataset.dias, 10), db = parseInt(b.dataset.dias, 10);
        if (da !== db) return da - db;
        return parseFloat(b.dataset.score) - parseFloat(a.dataset.score);
      });
      hijos.forEach(function (h) { lista.appendChild(h); });
    });
  }

  pintar();
});
</script>
